# developer.textalive.jp で取得したアプリトークン
VITE_TEXTALIVE_TOKEN=your-token-here
# サーバーAPIのベースURL(未設定時は https://1m26-18.trap.show/api/v1)
# ローカルサーバーで試す場合の例: VITE_API_BASE=http://localhost:8080/api/v1
VITE_API_BASE=http://localhost:8080/api/v1
# WebTransportサーバーのホスト名(未設定時は VITE_API_BASE から導出)
VITE_WEBTRANSPORT_HOST=localhost
# controller アプリのベースURL(ロビー画面の部屋参加QRコードに使う)
# 未設定時は viewer と同一ホストのポート5174(https なら https)を自動導出
# 実機スマホからスキャンする場合は PC の LAN IP を指定する 例: https://192.168.1.5:5174
#VITE_CONTROLLER_BASE_URL=https://192.168.1.5:5174
