# traQ からスタンプ画像を取得する (npm run stamps:fetch) ための認証情報。
# どちらか一方を設定する。
#
# 1) Bot / OAuth のアクセストークン
#TRAQ_TOKEN=
#
# 2) traQ のユーザー名とパスワード (POST /api/v3/login でセッション Cookie を取得する)
#TRAQ_USERNAME=
#TRAQ_PASSWORD=
#
# API のベース URL を上書きする場合 (通常は stamps.config.json の baseUrl を使う)
#TRAQ_BASE_URL=https://q.trap.jp/api/v3
